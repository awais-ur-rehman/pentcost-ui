# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1

# AI Features Configuration
VITE_ENABLE_AI_FEATURES=true

# Chrome AI API Configuration (Optional - for development/testing)
# These are automatically available in Chrome 127+ with AI features enabled
# VITE_CHROME_AI_ENABLED=true

# Development Configuration
VITE_APP_NAME=Pentecost Frontend
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true

# Optional: External Services (if needed in future)
# VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
# VITE_OPENAI_API_KEY=your_openai_api_key
